<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:AlToque.Localization"
        xmlns:ch="using:AlToque.Chasqui"
        x:Class="AlToque.Views.AskTextWindow"
        Title="Al Toque"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
  <StackPanel Margin="24,20" Spacing="16">
    <Grid ColumnDefinitions="Auto,*">
      <ch:ChasquiView Width="48" Height="48" State="Attentive" ShowRadar="False" VerticalAlignment="Top" />
      <TextBlock Grid.Column="1" x:Name="TitleText" Classes="strong" FontSize="15" TextWrapping="Wrap" Margin="14,0,0,0" VerticalAlignment="Center" />
    </Grid>
    <TextBox x:Name="Input" MaxLength="32" />
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="{x:Static l:S.SelectCancel}" Click="OnCancel" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
      <Button x:Name="OkButton" Classes="accent" Click="OnOk" MinWidth="90" HorizontalContentAlignment="Center" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AlToque.ViewModels"
        xmlns:ch="using:AlToque.Chasqui"
        xmlns:c="using:AlToque.Controls"
        xmlns:av="using:AlToque.Controls.Avatars"
        xmlns:l="using:AlToque.Localization"
        x:Class="AlToque.Views.QuickPanelWindow"
        x:DataType="vm:QuickPanelViewModel"
        Title="Al Toque"
        Width="440" SizeToContent="Height"
        WindowDecorations="None"
        ShowInTaskbar="True"
        CanMinimize="True"
        Topmost="{Binding KeepOnTop}"
        Icon="avares://AlToque/Assets/altoque.ico"
        Background="Transparent">
  <Border x:Name="Root" Classes="panel" DragDrop.AllowDrop="True" ClipToBounds="True">
    <Panel>
    <StackPanel x:Name="Sections" Spacing="18" Margin="20,16,20,20">
      <!-- Encabezado: se arrastra para mover la ventana -->
      <Grid x:Name="Header" ColumnDefinitions="Auto,*,Auto,Auto,Auto" Background="Transparent">
        <Border Width="30" Height="30" CornerRadius="7" Background="{StaticResource AccentBrush}">
          <c:IconView Kind="Send" Width="17" Height="17" Foreground="White" />
        </Border>
        <TextBlock Grid.Column="1" Text="Al Toque" Classes="subtitle" Margin="12,0" VerticalAlignment="Center" />
        <Button Grid.Column="2" Classes="icon" Classes.on="{Binding KeepOnTop}" Command="{Binding ToggleKeepOnTop}"
                ToolTip.Tip="{x:Static l:S.KeepOnTop}" AutomationProperties.Name="{x:Static l:S.KeepOnTop}">
          <c:IconView Kind="Pin" />
        </Button>
        <Button x:Name="SettingsButton" Grid.Column="3" Classes="icon" Command="{Binding OpenSettings}" ToolTip.Tip="{x:Static l:S.Settings}"
                AutomationProperties.Name="{x:Static l:S.Settings}">
          <c:IconView Kind="Settings" />
        </Button>
        <Button x:Name="MinimizeButton" Grid.Column="4" Classes="icon" Command="{Binding Minimize}" ToolTip.Tip="{x:Static l:S.Minimize}"
                AutomationProperties.Name="{x:Static l:S.Minimize}">
          <c:IconView Kind="Minus" />
        </Button>
      </Grid>

      <!-- Versión nueva -->
      <Border x:Name="UpdateBanner" Classes="card" Padding="14,12" Background="{DynamicResource AccentTintBrush}"
              BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" IsVisible="{Binding Update.ShowBanner, FallbackValue=False}">
        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
          <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
            <c:IconView Kind="Download" Width="20" Height="20" Foreground="White" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,6,0" VerticalAlignment="Center" Spacing="1">
            <TextBlock Text="{Binding Update.Title, FallbackValue=''}" Classes="strong" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Update.Detail, FallbackValue=''}" Classes="meta num" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Classes="icon small" Command="{Binding Update.Dismiss}" VerticalAlignment="Top"
                  ToolTip.Tip="{x:Static l:S.UpdateLater}" AutomationProperties.Name="{x:Static l:S.UpdateLater}">
            <c:IconView Kind="Close" />
          </Button>
          <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*,Auto" Margin="52,10,0,0">
            <ProgressBar Classes="update" Minimum="0" Maximum="100" Value="{Binding Update.Progress, FallbackValue=0}"
                         IsVisible="{Binding Update.IsDownloading, FallbackValue=False}" VerticalAlignment="Center" />
            <Button Classes="link" Content="{x:Static l:S.SeeWhatsNew}" Command="{Binding Update.OpenNotes}" HorizontalAlignment="Left"
                    Padding="0,4" IsVisible="{Binding !Update.IsDownloading, FallbackValue=False}" />
            <Button Grid.Column="1" Classes="accent" Content="{Binding Update.ActionText, FallbackValue=''}" Command="{Binding Update.Act}"
                    IsVisible="{Binding !Update.IsDownloading, FallbackValue=False}" />
          </Grid>
        </Grid>
      </Border>

      <!-- Destino pendiente ("Elegir destino…" o archivos soltados en el panel) -->
      <Border x:Name="PendingCard" Classes="card" IsVisible="{Binding HasPending}" Background="{DynamicResource AccentTintBrush}"
              BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <ch:ChasquiView Width="52" Height="52" State="Attentive" ShowRadar="False" />
            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="2">
              <TextBlock Text="{Binding PendingTitle}" Classes="strong" TextWrapping="Wrap" />
              <Button Classes="link" Padding="0,2" HorizontalAlignment="Left" Command="{Binding Connect}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <c:IconView Kind="Hash" Width="14" Height="14" />
                  <TextBlock Text="{x:Static l:S.SendByCode}" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Button Grid.Column="2" Classes="icon small" Command="{Binding ClearPending}" VerticalAlignment="Top"
                    ToolTip.Tip="{x:Static l:S.Cancel}" AutomationProperties.Name="{x:Static l:S.Cancel}">
              <c:IconView Kind="Close" />
            </Button>
          </Grid>
          <TextBox Text="{Binding Message}" PlaceholderText="{x:Static l:S.MessagePlaceholder}" MaxLength="500" />
        </StackPanel>
      </Border>

      <!-- Reposo: listo para enviar -->
      <Border x:Name="ReadyCard" Classes="card" IsVisible="{Binding ShowReadyCard}" Padding="14,12,16,12">
        <Grid ColumnDefinitions="Auto,*,Auto">
          <ch:ChasquiView x:Name="Mascot" Width="58" Height="58" State="{Binding Chasqui}" Progress="{Binding ChasquiProgress}"
                          ReduceMotion="{Binding ReduceMotion}" ShowRadar="False" />
          <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Static l:S.ReadyTitle}" Classes="strong" FontSize="16" />
            <TextBlock Text="{x:Static l:S.ReadyBody}" Classes="body2" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2" Command="{Binding ChooseFiles}" VerticalAlignment="Center" Padding="12,6">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:IconView Kind="Folder" Width="18" Height="18" />
              <TextBlock Text="{x:Static l:S.ChooseFilesShort}" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- Arrastrando -->
      <Border Classes="card" IsVisible="{Binding DragOver}" Background="{DynamicResource AccentTintBrush}"
              BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5" Padding="14,12,16,12">
        <Grid ColumnDefinitions="Auto,*">
          <ch:ChasquiView Width="64" Height="64" State="Attentive" ReduceMotion="{Binding ReduceMotion}" ShowRadar="False" />
          <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{x:Static l:S.DragTitle}" Classes="strong" FontSize="16" />
            <TextBlock Text="{Binding DragSummary}" Classes="body2 num" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Nadie en la red -->
      <StackPanel x:Name="NobodyView" IsVisible="{Binding ShowNobodyView}" Spacing="16">
        <ch:ChasquiView Width="156" Height="156" HorizontalAlignment="Center" State="{Binding Chasqui}"
                        ReduceMotion="{Binding ReduceMotion}" />
        <StackPanel Spacing="4">
          <TextBlock Text="{x:Static l:S.NobodyTitle}" Classes="subtitle" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
          <TextBlock Text="{Binding SearchText}" Classes="meta num" HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Border Classes="card" Padding="16,14">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="28,*">
              <c:IconView Kind="Check" Width="20" Height="20" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Top"
                          IsVisible="{Binding IsVisibleOnNetwork}" />
              <c:IconView Kind="EyeOff" Width="20" Height="20" VerticalAlignment="Top" IsVisible="{Binding !IsVisibleOnNetwork}" />
              <TextBlock Grid.Column="1" Text="{Binding VisibilityText}" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="28,*">
              <c:IconView Kind="Alert" Width="20" Height="20" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Static l:S.NobodyBlocking}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static l:S.NobodyBlockingHint}" Classes="meta" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="28,*">
              <c:IconView Kind="Help" Width="20" Height="20" VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Static l:S.NobodyOpen}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static l:S.NobodyOpenHint}" Classes="meta" TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Grid ColumnDefinitions="*,12,*">
          <Button Classes="accent big" HorizontalAlignment="Stretch" Command="{Binding Connect}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:IconView Kind="Hash" Width="18" Height="18" />
              <TextBlock Text="{x:Static l:S.ConnectByCode}" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="big" HorizontalAlignment="Stretch" Command="{Binding ShowMyCode}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:IconView Kind="Qr" Width="18" Height="18" />
              <TextBlock Text="{x:Static l:S.ShowMyCode}" />
            </StackPanel>
          </Button>
        </Grid>
        <Button x:Name="NobodyPair" Classes="link" HorizontalAlignment="Center" Command="{Binding Pair}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <c:IconView Kind="UserPlus" Width="16" Height="16" />
            <TextBlock Text="{x:Static l:S.PairNew}" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Compañeros -->
      <StackPanel IsVisible="{Binding ShowPeersArea}" Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center">
            <Run Text="{x:Static l:S.PeersHeader}" FontWeight="SemiBold" Foreground="{DynamicResource Text2Brush}" />
            <Run Text="{Binding PeersCountText}" Foreground="{DynamicResource Text3Brush}" />
          </TextBlock>
          <Button x:Name="PairLink" Grid.Column="1" Classes="link" Command="{Binding Pair}" IsVisible="{Binding !DragOver}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Kind="Plus" Width="16" Height="16" />
              <TextBlock Text="{x:Static l:S.PairShort}" />
            </StackPanel>
          </Button>
        </Grid>
        <ItemsControl x:Name="PeerList" ItemsSource="{Binding Peers}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemWidth="132" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PeerViewModel">
              <Panel Margin="2" Classes="peercard">
                <c:DashedBorder IsVisible="{Binding ShowDashedOutline}" Radius="8" Marching="True" />
                <Button Classes="peer" Classes.dropover="{Binding IsDropTarget}" HorizontalAlignment="Stretch"
                        Command="{Binding $parent[ItemsControl].((vm:QuickPanelViewModel)DataContext).PeerClicked}"
                        CommandParameter="{Binding}"
                        DragDrop.AllowDrop="True"
                        AutomationProperties.Name="{Binding AccessibleName}"
                        ToolTip.Tip="{Binding Symbols}">
                  <StackPanel Spacing="4" HorizontalAlignment="Center">
                    <av:AvatarView Width="86" Height="86" HorizontalAlignment="Center" AvatarId="{Binding AvatarId}" ColorHex="{Binding ColorHex}"
                                   Initial="{Binding Initial}" Ring="{Binding Ring}" Dimmed="{Binding Dimmed}" Mood="{Binding Mood}" />
                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="124"
                               FontWeight="SemiBold" FontSize="14.5" Opacity="{Binding Opacity}" />
                    <TextBlock Text="{Binding StatusLine}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="124"
                               Classes="meta" Classes.accent="{Binding IsDropTarget}" />
                  </StackPanel>
                </Button>
                <!-- ★ favorito (solo compañeros de confianza) y × quitar u ocultar -->
                <Button Classes="corner" Classes.on="{Binding IsFavorite}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6"
                        IsVisible="{Binding IsTrusted}"
                        Command="{Binding $parent[ItemsControl].((vm:QuickPanelViewModel)DataContext).ToggleFavorite}" CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding FavoriteTip}" AutomationProperties.Name="{Binding FavoriteTip}">
                  <c:IconView Kind="Star" />
                </Button>
                <Button Classes="corner danger" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                        Command="{Binding $parent[ItemsControl].((vm:QuickPanelViewModel)DataContext).RemovePeer}" CommandParameter="{Binding}"
                        ToolTip.Tip="{Binding RemoveTip}" AutomationProperties.Name="{Binding RemoveTip}">
                  <c:IconView Kind="Close" />
                </Button>
              </Panel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- O soltarlos en el panel -->
      <c:DashedBorder IsVisible="{Binding ShowDropForLater}" Radius="8" Marching="True" Padding="16,24">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource Surface2Brush}" HorizontalAlignment="Center">
            <c:IconView Kind="Message" Width="22" Height="22" />
          </Border>
          <TextBlock Text="{x:Static l:S.DropForLater}" Classes="strong" FontSize="16" HorizontalAlignment="Center" />
          <TextBlock Text="{x:Static l:S.DropForLaterHint}" Classes="body2" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
      </c:DashedBorder>

      <!-- Recientes -->
      <StackPanel IsVisible="{Binding ShowRecentArea}" Spacing="4">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{x:Static l:S.Recent}" Classes="label" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="link" Content="{x:Static l:S.SeeHistory}" Command="{Binding OpenHistory}" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Recent}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:HistoryItemViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                <Border Classes="tile" Classes.error="{Binding IsFailed}">
                  <c:IconView Kind="{Binding Icon}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}" Classes="meta" Classes.error="{Binding IsFailed}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Panel Grid.Column="2" VerticalAlignment="Center">
                  <c:IconView Kind="Check" Width="20" Height="20" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding ShowOk}" Margin="0,0,6,0" />
                  <Button Classes="link" Command="{Binding Retry}" IsVisible="{Binding CanRetry}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <c:IconView Kind="Retry" Width="16" Height="16" />
                      <TextBlock Text="{x:Static l:S.Retry}" />
                    </StackPanel>
                  </Button>
                  <Button Classes="icon small" Command="{Binding Open}" IsVisible="{Binding CanOpen}"
                          ToolTip.Tip="{x:Static l:S.OpenFolder}" AutomationProperties.Name="{x:Static l:S.OpenFolder}">
                    <c:IconView Kind="External" />
                  </Button>
                </Panel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Red pública -->
      <Border Classes="warnbox" IsVisible="{Binding NetworkPublic}">
        <Grid ColumnDefinitions="28,*" RowDefinitions="Auto,Auto">
          <c:IconView Kind="ShieldAlert" Width="20" Height="20" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="{x:Static l:S.NetworkPublicPaused}" TextWrapping="Wrap" />
          <Button Grid.Row="1" Grid.Column="1" Classes="link" Padding="0,8,0,0" HorizontalAlignment="Left"
                  Content="{x:Static l:S.AllowPublicNetwork}" Command="{Binding AllowPublicNetwork}" />
        </Grid>
      </Border>

      <!-- Quién puede enviarte -->
      <StackPanel x:Name="ModeSection" Spacing="12" Classes="muteable" Classes.muted="{Binding DragOver}">
        <Border Classes="divider" Margin="0,0,0,4" />
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{x:Static l:S.WhoCanSend}" Classes="label" VerticalAlignment="Center" />
          <Button Grid.Column="1" Classes="link" Command="{Binding ShowMyCode}" IsVisible="{Binding !ShowNobodyView}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <c:IconView Kind="Qr" Width="16" Height="16" />
              <TextBlock Text="{x:Static l:S.ShowMyCode}" />
            </StackPanel>
          </Button>
        </Grid>
        <c:Segmented AutomationProperties.Name="{x:Static l:S.TrayReceiveFrom}">
          <RadioButton Classes="segment" GroupName="panel-mode" IsChecked="{Binding ModeNobody}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:IconView Kind="EyeOff" />
              <TextBlock Text="{x:Static l:S.SegNobody}" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="segment" GroupName="panel-mode" IsChecked="{Binding ModeTrusted}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:IconView Kind="ShieldCheck" />
              <TextBlock Text="{x:Static l:S.SegTrusted}" />
            </StackPanel>
          </RadioButton>
          <RadioButton Classes="segment" GroupName="panel-mode" IsChecked="{Binding ModeEveryone}">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <c:IconView Kind="Users" />
              <TextBlock Text="{x:Static l:S.SegEveryone}" />
            </StackPanel>
          </RadioButton>
        </c:Segmented>
        <TextBlock Text="{Binding ModeHint}" Classes="body2" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
    <c:TourOverlay x:Name="TourLayer" />
    </Panel>
  </Border>
</Window>

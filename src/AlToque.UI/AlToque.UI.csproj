<Project Sdk="Microsoft.NET.Sdk">
  <!-- Diseño compartido por la app de escritorio y la de Android: tema, controles, Chasqui, avatares y textos. -->
  <PropertyGroup>
    <RootNamespace>AlToque</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <!-- La misma versión que usa Avalonia para dibujar: miniaturas de fotos con su orientación. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AlToque.Core\AlToque.Core.csproj" />
  </ItemGroup>
</Project>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="using:AlToque.Localization"
        xmlns:ch="using:AlToque.Chasqui"
        x:Class="AlToque.Views.ConfirmWindow"
        Title="Al Toque"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
  <StackPanel Margin="24,20" Spacing="18">
    <Grid ColumnDefinitions="Auto,*">
      <ch:ChasquiView Width="56" Height="56" State="Attentive" ShowRadar="False" VerticalAlignment="Top" />
      <TextBlock Grid.Column="1" x:Name="MessageText" TextWrapping="Wrap" FontSize="14" Margin="14,4,0,0" VerticalAlignment="Center" />
    </Grid>
    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
      <Button Content="{x:Static l:S.No}" Click="OnNo" MinWidth="90" HorizontalContentAlignment="Center" IsCancel="True" />
      <Button Classes="accent" Content="{x:Static l:S.Yes}" Click="OnYes" MinWidth="90" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</Window>

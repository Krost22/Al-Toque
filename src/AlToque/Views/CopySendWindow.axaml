<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AlToque.ViewModels"
        xmlns:c="using:AlToque.Controls"
        xmlns:av="using:AlToque.Controls.Avatars"
        xmlns:l="using:AlToque.Localization"
        x:Class="AlToque.Views.CopySendWindow"
        x:DataType="vm:CopySendViewModel"
        Title="Al Toque"
        Width="340" SizeToContent="Height"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Background="Transparent">
  <Border x:Name="Root" Classes="panel" Padding="14,12,8,12">
    <StackPanel Spacing="10">
      <!-- Encabezado: marca + qué pasó + cerrar -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
          <c:IconView Kind="{Binding PreviewIcon}" Width="16" Height="16" Foreground="White" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0,6,0" VerticalAlignment="Center" Spacing="1">
          <TextBlock Text="{Binding Title}" Classes="strong" TextWrapping="Wrap" Classes.error="{Binding IsError}" />
          <TextBlock Text="{Binding Preview}" IsVisible="{Binding HasPreview}" Classes="meta" TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" Classes="icon small" VerticalAlignment="Top" Command="{Binding Close}"
                ToolTip.Tip="{x:Static l:S.Close}" AutomationProperties.Name="{x:Static l:S.Close}">
          <c:IconView Kind="Close" />
        </Button>
      </Grid>

      <!-- Se copió algo: un botón -->
      <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsOffer}" Margin="40,0,6,0">
        <Button Classes="accent" HorizontalAlignment="Stretch" Command="{Binding Send}">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <c:IconView Kind="Send" Width="16" Height="16" Foreground="White" />
            <TextBlock Text="{Binding SendText}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Grid.Column="1" Margin="6,0,0,0" Command="{Binding Choose}" IsVisible="{Binding HasTarget}"
                ToolTip.Tip="{x:Static l:S.CopySendOther}" AutomationProperties.Name="{x:Static l:S.CopySendOther}">
          <c:IconView Kind="Users" Width="16" Height="16" />
        </Button>
      </Grid>

      <!-- ¿A quién? -->
      <ScrollViewer IsVisible="{Binding IsPick}" MaxHeight="300" Margin="0,0,6,0">
        <ItemsControl ItemsSource="{Binding Choices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:CopyChoiceViewModel">
              <Button Classes="row" Command="{Binding Pick}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="6">
                <Grid ColumnDefinitions="Auto,*">
                  <av:AvatarView Width="34" Height="34" AvatarId="{Binding AvatarId}" ColorHex="{Binding ColorHex}" Initial="{Binding Initial}"
                                 Ring="Verified" Mood="Happy" />
                  <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Status}" Classes="meta" />
                  </StackPanel>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>
  </Border>
</Window>

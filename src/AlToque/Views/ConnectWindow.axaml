<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:AlToque.ViewModels"
        xmlns:c="using:AlToque.Controls"
        xmlns:av="using:AlToque.Controls.Avatars"
        xmlns:l="using:AlToque.Localization"
        x:Class="AlToque.Views.ConnectWindow"
        x:DataType="vm:ConnectViewModel"
        Title="{x:Static l:S.ConnectTitle}"
        Icon="avares://AlToque/Assets/altoque.ico"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterScreen">
  <StackPanel Margin="28,22,28,26" Spacing="16">
    <StackPanel Spacing="4">
      <TextBlock Text="{x:Static l:S.ConnectTitle}" Classes="subtitle" />
      <TextBlock Text="{x:Static l:S.ConnectHint}" TextWrapping="Wrap" Classes="body2" />
    </StackPanel>

    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="InputBox" Text="{Binding Input}" PlaceholderText="K7Q2-9XM4 · 192.168.1.20" FontSize="16" Classes="num" />
      <Button Grid.Column="1" Classes="accent" Command="{Binding Find}" Margin="10,0,0,0" IsDefault="True" MinHeight="36">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:IconView Kind="Hash" Width="16" Height="16" />
          <TextBlock Text="{x:Static l:S.ConnectProbe}" />
        </StackPanel>
      </Button>
    </Grid>

    <TextBlock x:Name="StatusText" Text="{Binding Status}" IsVisible="{Binding HasStatus}" TextWrapping="Wrap"
               Classes.error="{Binding IsError}" Classes.body2="{Binding !IsError}" />

    <Border x:Name="FoundCard" Classes="card" IsVisible="{Binding HasTarget}">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="Auto,*">
          <av:AvatarView Width="64" Height="64" AvatarId="{Binding FoundAvatarId}" ColorHex="{Binding FoundColorHex}" Initial="{Binding FoundInitial}"
                         Ring="{Binding FoundRing}" PopOnLoad="True" />
          <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center" Spacing="3">
            <WrapPanel>
              <TextBlock Text="{Binding FoundName}" Classes="strong" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" />
              <Border Classes="chip success" IsVisible="{Binding FoundTrusted}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:IconView Kind="ShieldCheck" />
                  <TextBlock Text="{x:Static l:S.ChipTrusted}" />
                </StackPanel>
              </Border>
              <Border Classes="chip warning" IsVisible="{Binding !FoundTrusted}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                  <c:IconView Kind="Alert" />
                  <TextBlock Text="{x:Static l:S.ChipUnverified}" />
                </StackPanel>
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding FoundSymbols}" Foreground="{Binding FoundColor}" FontSize="16" />
          </StackPanel>
        </Grid>
        <Button Classes="accent big" Command="{Binding Send}" HorizontalAlignment="Stretch">
          <TextBlock Text="{Binding SendLabel}" TextTrimming="CharacterEllipsis" />
        </Button>
      </StackPanel>
    </Border>

    <Border Classes="divider" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{x:Static l:S.ConnectBlocked}" TextWrapping="Wrap" Classes="meta" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Grid.Column="1" Command="{Binding ToggleMyCode}" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <c:IconView Kind="Qr" Width="16" Height="16" />
          <TextBlock Text="{x:Static l:S.ShowMyCode}" />
        </StackPanel>
      </Button>
    </Grid>
    <Border x:Name="MyCodeCard" Classes="card" IsVisible="{Binding ShowMyCode}" Padding="20">
      <StackPanel Spacing="8">
        <TextBlock Text="{x:Static l:S.MyCodeHint}" Classes="meta" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
        <SelectableTextBlock Text="{Binding MyCode}" FontSize="36" FontWeight="SemiBold" HorizontalAlignment="Center" LetterSpacing="3"
                             FontFeatures="+tnum" FontFamily="{StaticResource DisplayFont}" />
        <SelectableTextBlock Text="{Binding MyAddresses}" Classes="caption" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
